// HeyStudy — MVP Fase 1
// Modelo de datos según sección 4 del spec: un solo estudiante cargando sus
// propios datos manualmente. Sin Institution / multi-tenant / roles.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / perfil
// ---------------------------------------------------------------------------

// Refleja auth.users de Supabase. El id es el mismo UUID que Supabase Auth
// asigna al usuario; no se genera aquí. Se crea vía trigger o en el primer
// login/registro.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now())

  studentProfile StudentProfile?
  subscription   Subscription?
  aiUsageLogs    AIUsageLog[]

  @@map("users")
}

enum EducationLevel {
  PRIMARIA
  SECUNDARIA
  PREPARATORIA
  UNIVERSIDAD
  OTRO
}

enum StudyMethod {
  VIDEOS
  LECTURA
  PRACTICA
  MIXTO
}

model StudentProfile {
  id                       String         @id @default(uuid()) @db.Uuid
  userId                   String         @unique @db.Uuid
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName              String
  educationLevel           EducationLevel
  // Cómo prefiere estudiar (personalización): si incluye video (VIDEOS o
  // MIXTO), el plan de estudio le sugiere videos de YouTube para sus temas
  // más débiles del día (ver videoService.ts). MIXTO por default para no
  // requerir backfill en perfiles creados antes de este campo.
  preferredStudyMethod     StudyMethod    @default(MIXTO)
  timezone                 String         @default("America/Mexico_City")
  // Recordatorio diario por correo de repasos vencidos (ver
  // reviewReminderService.ts). Encendido por default: es lo que hace que la
  // repetición espaciada sirva de algo — sin un empujón, sólo funciona si el
  // estudiante abre la app justo el día que le toca repasar.
  reviewRemindersEnabled   Boolean        @default(true)
  lastReviewReminderSentAt DateTime?
  // Resumen semanal por correo (ver weeklyReportService.ts) y aviso de
  // tareas/exámenes próximos (ver deadlineReminderService.ts) — mismo patrón
  // de opt-out que reviewRemindersEnabled: encendidos por default, apagables
  // desde el perfil.
  weeklyReportEnabled       Boolean        @default(true)
  lastWeeklyReportSentAt    DateTime?
  deadlineRemindersEnabled  Boolean        @default(true)
  lastDeadlineReminderSentAt DateTime?
  // Correo opcional de un padre/tutor (sección 4.5): lo da el propio
  // estudiante, nunca se pide en el registro ni se infiere de nada — null
  // significa que no hay a quién mandarle nada. Ver parentReportService.ts.
  parentEmail               String?
  parentReportEnabled       Boolean        @default(false)
  lastParentReportSentAt    DateTime?
  // Programa de referidos: código propio (se genera una vez, al crear el
  // perfil) y, si este estudiante llegó por el link de alguien más, quién lo
  // trajo — se fija una sola vez en completeOnboarding y ya no cambia.
  referralCode              String?        @unique
  referredByStudentProfileId String?       @db.Uuid
  referredBy                StudentProfile? @relation("Referrals", fields: [referredByStudentProfileId], references: [id], onDelete: SetNull)
  referrals                 StudentProfile[] @relation("Referrals")
  onboardedAt              DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  subjects           Subject[]
  knowledgeMastery   KnowledgeMastery[]
  studySessions      StudySession[]
  errorPatterns      ErrorPattern[]
  studyPlans         StudyPlan[]
  grades             Grade[]
  tutorConversations TutorConversation[]
  customTutors       CustomTutor[]

  ownedStudyGroups  StudyGroup[]       @relation("StudyGroupOwner")
  studyGroupMembers StudyGroupMember[]
  sharedStudyPlans  SharedStudyPlan[]

  @@map("student_profiles")
}

// ---------------------------------------------------------------------------
// Grupos de estudio — estudiar acompañado
// ---------------------------------------------------------------------------

// Se entra por código, no buscando personas: buscar por correo o nombre
// permitiría averiguar quién tiene cuenta en HeyStudy.
model StudyGroup {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  joinCode  String         @unique
  ownerId   String         @db.Uuid
  owner     StudentProfile @relation("StudyGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  members     StudyGroupMember[]
  sharedPlans SharedStudyPlan[]

  @@index([ownerId])
  @@map("study_groups")
}

enum StudyGroupRole {
  OWNER
  MIEMBRO
}

model StudyGroupMember {
  id               String         @id @default(uuid()) @db.Uuid
  studyGroupId     String         @db.Uuid
  studyGroup       StudyGroup     @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  role             StudyGroupRole @default(MIEMBRO)
  joinedAt         DateTime       @default(now())
  // Último lugar visto en el ranking del grupo (ver
  // groupRankNotificationService.ts) — null hasta el primer cálculo. Sirve
  // sólo para detectar "alguien te rebasó" comparando contra el ranking
  // actual; no es un historial, se sobreescribe en cada corrida del cron.
  lastKnownRank    Int?

  @@unique([studyGroupId, studentProfileId])
  @@index([studyGroupId])
  @@index([studentProfileId])
  @@map("study_group_members")
}

// Compartir es opt-in y por plan: nadie publica sus planes al grupo por el
// simple hecho de ser miembro. Aun así, esto solo expone los ítems del plan
// (qué estudiar y cuántos minutos). El diagnóstico, el mastery por tema, los
// patrones de error y las calificaciones nunca salen del dueño.
model SharedStudyPlan {
  id           String         @id @default(uuid()) @db.Uuid
  studyPlanId  String         @db.Uuid
  studyPlan    StudyPlan      @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  studyGroupId String         @db.Uuid
  studyGroup   StudyGroup     @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  sharedById   String         @db.Uuid
  sharedBy     StudentProfile @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  sharedAt     DateTime       @default(now())

  @@unique([studyPlanId, studyGroupId])
  @@index([studyGroupId])
  @@map("shared_study_plans")
}

// ---------------------------------------------------------------------------
// Materias, tareas, exámenes, materiales — cargados manualmente
// ---------------------------------------------------------------------------

model Subject {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  color            String         @default("#C1502E")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  assignments        Assignment[]
  exams              Exam[]
  materials          Material[]
  knowledgeTopics    KnowledgeTopic[]
  grades             Grade[]
  tutorConversations TutorConversation[]
  customTutors       CustomTutor[]

  @@index([studentProfileId])
  @@map("subjects")
}

enum AssignmentStatus {
  PENDIENTE
  COMPLETADA
}

model Assignment {
  id          String           @id @default(uuid()) @db.Uuid
  subjectId   String           @db.Uuid
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  status      AssignmentStatus @default(PENDIENTE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([subjectId])
  @@map("assignments")
}

model Exam {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @db.Uuid
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  examDate  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics            ExamTopic[]
  grades            Grade[]
  studySessions     StudySession[]
  readinessSnapshot ReadinessSnapshot?

  @@index([subjectId])
  @@map("exams")
}

// La "predicción" congelada del Exam Readiness Score, para poder comparar
// contra la calificación real después (sección 4.5: "comparar contra el
// Exam Readiness Score que la app había calculado antes del examen").
// calculateExamReadiness() no guarda nada por sí solo — se recalcula en
// vivo cada vez que se pide — así que sin esto no habría ningún registro
// de "qué predijo la app" una vez que el mastery del estudiante se mueve
// después del examen. Se actualiza en cada lectura mientras el examen no
// haya pasado, y se congela en cuanto pasa la fecha.
model ReadinessSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  examId     String   @unique @db.Uuid
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  score      Int
  capturedAt DateTime @default(now())

  @@map("readiness_snapshots")
}

// Relación N:M entre Exam y KnowledgeTopic, con un peso para el cálculo
// explicable del Exam Readiness Score (sección 5, etapa 3).
model ExamTopic {
  id               String         @id @default(uuid()) @db.Uuid
  examId           String         @db.Uuid
  exam             Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  knowledgeTopicId String         @db.Uuid
  knowledgeTopic   KnowledgeTopic @relation(fields: [knowledgeTopicId], references: [id], onDelete: Cascade)
  weight           Float          @default(1)

  @@unique([examId, knowledgeTopicId])
  @@map("exam_topics")
}

enum MaterialType {
  PDF
  IMAGEN
}

model Material {
  id          String       @id @default(uuid()) @db.Uuid
  subjectId   String       @db.Uuid
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    MaterialType
  storagePath String
  fileSizeKb  Int?
  uploadedAt  DateTime     @default(now())

  @@index([subjectId])
  @@map("materials")
}

model Grade {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subjectId        String         @db.Uuid
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examId           String?        @db.Uuid
  exam             Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  label            String
  score            Float
  maxScore         Float          @default(100)
  recordedAt       DateTime       @default(now())

  @@index([studentProfileId])
  @@index([subjectId])
  @@map("grades")
}

// ---------------------------------------------------------------------------
// Knowledge map
// ---------------------------------------------------------------------------

// Concepto dentro de una materia. Jerárquico: Álgebra → Funciones → Cuadráticas.
model KnowledgeTopic {
  id          String           @id @default(uuid()) @db.Uuid
  subjectId   String           @db.Uuid
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentId    String?          @db.Uuid
  parent      KnowledgeTopic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeTopic[] @relation("TopicHierarchy")
  name        String
  description String?
  createdAt   DateTime         @default(now())

  mastery           KnowledgeMastery[]
  questions         Question[]
  errorPatterns     ErrorPattern[]
  examTopics        ExamTopic[]
  studyPlanItems    StudyPlanItem[]
  recommendedVideos RecommendedVideo[]

  @@index([subjectId])
  @@index([parentId])
  @@map("knowledge_topics")
}

// Cache de resultados de YouTube Data API por tema (sección de
// personalización: estudiantes que prefieren video reciben sugerencias
// reales, no inventadas por la IA). Cachear por tema —no por estudiante—
// porque el contenido educativo de un tema no cambia entre estudiantes, y
// el free tier de la API de YouTube es de sólo 100 búsquedas/día
// (search.list cuesta 100 de las 10,000 unidades diarias).
model RecommendedVideo {
  id               String         @id @default(uuid()) @db.Uuid
  knowledgeTopicId String         @db.Uuid
  knowledgeTopic   KnowledgeTopic @relation(fields: [knowledgeTopicId], references: [id], onDelete: Cascade)
  youtubeVideoId   String
  title            String
  channelTitle     String
  thumbnailUrl     String
  fetchedAt        DateTime       @default(now())

  @@unique([knowledgeTopicId, youtubeVideoId])
  @@index([knowledgeTopicId])
  @@map("recommended_videos")
}

// Mastery de un StudentProfile sobre un KnowledgeTopic. Se actualiza con
// evidencia acumulativa (cada Answer nueva), no es un diagnóstico fijo.
model KnowledgeMastery {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  knowledgeTopicId String         @db.Uuid
  knowledgeTopic   KnowledgeTopic @relation(fields: [knowledgeTopicId], references: [id], onDelete: Cascade)
  score            Float          @default(0) // 0-1
  confidence       Float          @default(0) // 0-1, qué tanta evidencia respalda el score
  lastReviewed     DateTime?
  nextReview       DateTime?
  errorCount       Int            @default(0)
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, knowledgeTopicId])
  // Soporta getOverdueReviewTopics (studyPlanService), que corre en cada
  // generación de plan filtrando por studentProfileId + nextReview <= ahora.
  @@index([studentProfileId, nextReview])
  @@map("knowledge_mastery")
}

// ---------------------------------------------------------------------------
// Diagnóstico / práctica
// ---------------------------------------------------------------------------

enum StudySessionMode {
  DIAGNOSTICO
  PRACTICA
}

model StudySession {
  id               String           @id @default(uuid()) @db.Uuid
  studentProfileId String           @db.Uuid
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  examId           String?          @db.Uuid
  exam             Exam?            @relation(fields: [examId], references: [id], onDelete: SetNull)
  mode             StudySessionMode @default(DIAGNOSTICO)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?

  questions Question[]

  @@index([studentProfileId])
  @@map("study_sessions")
}

enum QuestionDifficulty {
  FACIL
  MEDIO
  DIFICIL
}

model Question {
  id               String             @id @default(uuid()) @db.Uuid
  studySessionId   String             @db.Uuid
  studySession     StudySession       @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  knowledgeTopicId String             @db.Uuid
  knowledgeTopic   KnowledgeTopic     @relation(fields: [knowledgeTopicId], references: [id], onDelete: Cascade)
  prompt           String
  difficulty       QuestionDifficulty
  correctAnswer    String?
  options          Json?
  createdAt        DateTime           @default(now())

  answer Answer?

  @@index([studySessionId])
  @@index([knowledgeTopicId])
  @@map("questions")
}

// Cada respuesta se analiza más allá de correcto/incorrecto: se extrae una
// estimación de mastery y, si aplica, un patrón de error.
model Answer {
  id              String        @id @default(uuid()) @db.Uuid
  questionId      String        @unique @db.Uuid
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentResponse String
  isCorrect       Boolean?
  masteryEstimate Float?
  feedback        String?
  errorPatternId  String?       @db.Uuid
  errorPattern    ErrorPattern? @relation(fields: [errorPatternId], references: [id], onDelete: SetNull)
  answeredAt      DateTime      @default(now())

  @@map("answers")
}

model ErrorPattern {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  knowledgeTopicId String         @db.Uuid
  knowledgeTopic   KnowledgeTopic @relation(fields: [knowledgeTopicId], references: [id], onDelete: Cascade)
  description      String
  occurrences      Int            @default(1)
  firstDetectedAt  DateTime       @default(now())
  lastDetectedAt   DateTime       @default(now())

  answers Answer[]

  @@index([studentProfileId])
  @@index([knowledgeTopicId])
  // Soporta el dedup de errorPattern.findFirst (masteryService) por
  // studentProfileId + knowledgeTopicId, que corre en cada respuesta
  // incorrecta de un diagnóstico o práctica.
  @@index([studentProfileId, knowledgeTopicId])
  @@map("error_patterns")
}

// ---------------------------------------------------------------------------
// Plan de estudio
// ---------------------------------------------------------------------------

model StudyPlan {
  id               String         @id @default(uuid()) @db.Uuid
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  forDate          DateTime       @db.Date
  generatedAt      DateTime       @default(now())

  items      StudyPlanItem[]
  sharedWith SharedStudyPlan[]

  @@unique([studentProfileId, forDate])
  @@map("study_plans")
}

model StudyPlanItem {
  id               String          @id @default(uuid()) @db.Uuid
  studyPlanId      String          @db.Uuid
  studyPlan        StudyPlan       @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  knowledgeTopicId String?         @db.Uuid
  knowledgeTopic   KnowledgeTopic? @relation(fields: [knowledgeTopicId], references: [id], onDelete: SetNull)
  title            String
  reason           String
  minutes          Int
  orderIndex       Int             @default(0)
  completed        Boolean         @default(false)

  @@index([studyPlanId])
  @@map("study_plan_items")
}

// ---------------------------------------------------------------------------
// Tutor IA — chat contextual por materia
// ---------------------------------------------------------------------------

enum TutorConversationMode {
  SOCRATICO
  EXPLICAR
  PISTA
  PRACTICA
}

enum TutorMessageRole {
  USER
  ASSISTANT
}

model TutorConversation {
  id               String                @id @default(uuid()) @db.Uuid
  studentProfileId String                @db.Uuid
  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subjectId        String                @db.Uuid
  subject          Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mode             TutorConversationMode @default(EXPLICAR)
  // Tutor personalizado del estudiante. Si es null, se usa el tutor por
  // defecto de HeyStudy con el comportamiento del `mode`.
  customTutorId    String?               @db.Uuid
  customTutor      CustomTutor?          @relation(fields: [customTutorId], references: [id], onDelete: SetNull)
  title            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  messages TutorChatMessage[]

  @@index([studentProfileId])
  @@index([subjectId])
  @@map("tutor_conversations")
}

// Tutor que el estudiante define a su gusto: nombre, personalidad y estilo
// de explicación.
model CustomTutor {
  id               String                @id @default(uuid()) @db.Uuid
  studentProfileId String                @db.Uuid
  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  emoji            String                @default("🎓")
  // Texto libre escrito por el estudiante. Se trata como entrada NO confiable:
  // viaja en una sección delimitada del system prompt y nunca puede
  // sobreescribir las reglas de HeyStudy (ver AIProvider.tutorResponse).
  instructions     String
  // Modo base sobre el que se apoya la personalidad.
  baseMode         TutorConversationMode @default(EXPLICAR)
  // Opcional: si se fija, el tutor solo aparece en esa materia.
  subjectId        String?               @db.Uuid
  subject          Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  conversations TutorConversation[]

  @@index([studentProfileId])
  @@index([subjectId])
  @@map("custom_tutors")
}

model TutorChatMessage {
  id                  String            @id @default(uuid()) @db.Uuid
  tutorConversationId String            @db.Uuid
  tutorConversation   TutorConversation @relation(fields: [tutorConversationId], references: [id], onDelete: Cascade)
  role                TutorMessageRole
  content             String
  createdAt           DateTime          @default(now())

  @@index([tutorConversationId])
  @@map("tutor_chat_messages")
}

// ---------------------------------------------------------------------------
// Freemium / observabilidad de costo
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  PAID
}

model Subscription {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  PlanTier @default(FREE)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  currentPeriodStart    DateTime @default(now())
  currentPeriodEnd      DateTime
  diagnosticsUsed       Int      @default(0)
  documentsAnalyzedUsed Int      @default(0)
  // Días de plan pagado ganados por referidos (ver referralService.ts), no
  // por Stripe (que todavía no está conectado). Se trata aparte de `plan`
  // para no pisar una suscripción real cuando exista: el plan efectivo es
  // PAID si `plan` ya es PAID o si `bonusPaidUntil` sigue en el futuro (ver
  // getEffectivePlan en usage/effectivePlan.ts).
  bonusPaidUntil        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("subscriptions")
}

// Límite técnico de solicitudes por minuto, independiente del plan (sección
// 8.5). Un registro por intento permitido; se cuenta cuántos hay en la
// ventana antes de dejar pasar uno nuevo. `key` combina el propósito y el
// identificador (ej. "ai:<userId>") para poder reusar la misma tabla con
// distintos límites sin necesitar una tabla por caso de uso.
model RateLimitEvent {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_events")
}

// Un registro por llamada a la API de Anthropic. Crítico para validar costo
// real por usuario activo (sección 8).
model AIUsageLog {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model               String
  feature             String
  inputTokens         Int
  outputTokens        Int
  // Prompt caching (tutor_chat): tokens que se escribieron en caché por
  // primera vez esta llamada (~1.25x el precio normal) vs. tokens que se
  // leyeron de una caché ya existente (~0.1x). 0 en llamadas sin caching.
  // Sin estos dos campos, sumar sólo inputTokens subestima el costo real en
  // cuanto la caché del tutor empieza a pegar.
  cacheCreationTokens Int      @default(0)
  cacheReadTokens     Int      @default(0)
  estimatedCostUsd    Float
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([feature])
  @@map("ai_usage_logs")
}
