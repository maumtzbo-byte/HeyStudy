# Supabase — proyecto "heystudy"
NEXT_PUBLIC_SUPABASE_URL="https://dvinjjwstbukxpttrlbz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Prisma — conexión a Postgres de Supabase.
# DATABASE_URL: pooled (pgbouncer, puerto 6543) — usada en runtime por la app.
# DIRECT_URL: directa (puerto 5432) — usada solo por el CLI de Prisma (migrate).
# La contraseña debe ir URL-encoded si tiene caracteres especiales (p. ej. "/" -> "%2F").
DATABASE_URL="postgresql://postgres.dvinjjwstbukxpttrlbz:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dvinjjwstbukxpttrlbz:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Anthropic — nunca exponer al cliente, solo se usa en backend.
ANTHROPIC_API_KEY=""

# Stripe (Etapa 5 — freemium). Dejar vacío hasta esa etapa.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PAID=""

# YouTube Data API v3 — recomendaciones de video para estudiantes que
# prefieren estudiar así (ver videoService.ts). Opcional: sin esta key la
# app funciona igual, sólo no muestra videos. Consíguela gratis en
# https://console.cloud.google.com/apis/credentials (habilita "YouTube Data
# API v3" en el proyecto). Free tier: 10,000 unidades/día.
YOUTUBE_API_KEY=""

# Resend — correo del recordatorio diario de repasos vencidos (ver
# reviewReminderService.ts, disparado por el cron en vercel.json). Crea una
# cuenta gratis en https://resend.com, y para que los correos lleguen a
# estudiantes reales (no sólo a tu propio correo de prueba) tienes que
# verificar un dominio propio ahí y poner ese remitente en RESEND_FROM_EMAIL
# — mientras tanto se usa el remitente de prueba de Resend, que sólo entrega
# al dueño de la cuenta.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HeyStudy <recordatorios@tudominio.com>"

# URL pública de producción — el cron corre sin una petición de por medio,
# así que el link "Repasar ahora" del correo no puede derivar el dominio de
# ningún request. Pon aquí tu dominio real de producción.
NEXT_PUBLIC_APP_URL="https://heystudy.app"

# Secreto compartido con Vercel Cron para que sólo Vercel pueda disparar
# /api/cron/review-reminders. Cualquier string largo y aleatorio sirve —
# Vercel lo manda solo como header Authorization en cada llamada al cron
# (ver vercel.json), no hace falta configurarlo ahí manualmente.
CRON_SECRET=""
