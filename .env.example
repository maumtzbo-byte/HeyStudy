# Supabase — proyecto "heystudy"
NEXT_PUBLIC_SUPABASE_URL="https://dvinjjwstbukxpttrlbz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Prisma — conexión a Postgres de Supabase.
# DATABASE_URL: pooled (pgbouncer, puerto 6543) — usada en runtime por la app.
# DIRECT_URL: directa (puerto 5432) — usada solo por el CLI de Prisma (migrate).
# La contraseña debe ir URL-encoded si tiene caracteres especiales (p. ej. "/" -> "%2F").
DATABASE_URL="postgresql://postgres.dvinjjwstbukxpttrlbz:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dvinjjwstbukxpttrlbz:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Anthropic — nunca exponer al cliente, solo se usa en backend.
ANTHROPIC_API_KEY=""

# Stripe (Etapa 5 — freemium). Dejar vacío hasta esa etapa.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PAID=""
